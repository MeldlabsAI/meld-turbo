From e376b64d9b94ca83614e876298357007f961987b Mon Sep 17 00:00:00 2001
From: Tim <338195936+tim-meld@users.noreply.github.com>
Date: Mon, 5 Oct 2026 07:06:05 +0800
Subject: [PATCH 06/12] metal (debug): GGML_METAL_CB_TIMING prints GPU
 start/end of every command buffer; GGML_METAL_N_CB_FORCE splits graphs into
 more command buffers

Measures how long a graph really runs on the GPU (and each part of it), separate from CPU-side waits.
---
 ggml/src/ggml-metal/ggml-metal-context.m | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/ggml/src/ggml-metal/ggml-metal-context.m b/ggml/src/ggml-metal/ggml-metal-context.m
index 442ed2a..b978725 100644
--- a/ggml/src/ggml-metal/ggml-metal-context.m
+++ b/ggml/src/ggml-metal/ggml-metal-context.m
@@ -471,6 +471,21 @@ bool ggml_metal_cpy_tensor_async(ggml_metal_t ctx_src, ggml_metal_t ctx_dst, con
     }
 }
 
+// meld-turbo: GGML_METAL_CB_TIMING=1 prints the GPU start/end time of every command buffer of a graph
+//   cbtime <graph nodes> <cb index> <gpu start s> <gpu end s>
+static void ggml_metal_cb_timing(id<MTLCommandBuffer> cmd_buf, int n_nodes, int idx) {
+    static int enabled = -1;
+    if (enabled < 0) {
+        enabled = getenv("GGML_METAL_CB_TIMING") != NULL;
+    }
+    if (!enabled) {
+        return;
+    }
+    [cmd_buf addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+        fprintf(stderr, "cbtime %d %d %.6f %.6f\n", n_nodes, idx, cb.GPUStartTime, cb.GPUEndTime);
+    }];
+}
+
 enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph * gf) {
     if (ctx->has_error) {
         GGML_LOG_ERROR("%s: backend is in error state from a previous command buffer failure - recreate the backend to recover\n", __func__);
@@ -559,6 +574,7 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
                 [ctx->cmd_bufs[n_cb].obj release];
             }
             ctx->cmd_bufs[n_cb].obj = cmd_buf;
+            ggml_metal_cb_timing(cmd_buf, gf->n_nodes, n_cb);
 
             [cmd_buf enqueue];
 
@@ -578,6 +594,7 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
                 [ctx->cmd_bufs[cb_idx].obj release];
             }
             ctx->cmd_bufs[cb_idx].obj = cmd_buf;
+            ggml_metal_cb_timing(cmd_buf, gf->n_nodes, cb_idx);
 
             // always enqueue the first two command buffers
             // enqueue all of the command buffers if we don't need to abort
@@ -710,6 +727,12 @@ void ggml_metal_set_n_cb(ggml_metal_t ctx, int n_cb) {
         n_cb = 0;
     }
 
+    // meld-turbo: GGML_METAL_N_CB_FORCE=k splits every graph into k+1 command buffers (with
+    // GGML_METAL_CB_TIMING this gives the GPU time of each part of the graph)
+    if (getenv("GGML_METAL_N_CB_FORCE") != NULL) {
+        n_cb = atoi(getenv("GGML_METAL_N_CB_FORCE"));
+    }
+
     if (ctx->n_cb != n_cb) {
         ctx->n_cb = MIN(n_cb, GGML_METAL_MAX_COMMAND_BUFFERS);
 
