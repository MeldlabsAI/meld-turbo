+    const bool ext_float_row = (op->src[0]->type == GGML_TYPE_F32 || op->src[0]->type == GGML_TYPE_F16 ||
+                                op->src[0]->type == GGML_TYPE_BF16) && ne00 % 64 == 0;
+    if (op->src[1]->type == GGML_TYPE_F32 && (ne00%128 == 0 || ext_float_row) &&
