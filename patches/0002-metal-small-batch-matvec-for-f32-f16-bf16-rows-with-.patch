 ggml/src/ggml-metal/ggml-metal-ops.cpp | 55 +++++++++++++++++++++++++-
 1 file changed, 54 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 29db37f..14b4036 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -1,3 +1,6 @@
+#include <cstdlib>
+#include <vector>
+#include <string>
 #include "ggml-metal-ops.h"
 
 #include "ggml.h"
@@ -180,6 +183,45 @@ static bool ggml_metal_op_concurrency_add(ggml_metal_op_t ctx, const ggml_tensor
     return ggml_mem_ranges_add(ctx->mem_ranges, node);
 }
 
+// Profiling aid (meld-turbo): GGML_METAL_ABLATE="OP[:src0type],..." skips encoding matching nodes,
+// e.g. GGML_METAL_ABLATE="MUL_MAT:q6_K,MUL". Results become garbage; the speed-up measures what those
+// ops really cost inside the full graph (with concurrency and real cache state), which timing ops in
+// isolation does not. Never list ops that produce indices (ARGSORT, TOP_K, ...): later ops would read
+// out of bounds.
+static bool ggml_metal_op_ablated(const struct ggml_tensor * node) {
+    static const std::vector<std::pair<std::string, std::string>> rules = [] {
+        std::vector<std::pair<std::string, std::string>> r;
+        const char * env = getenv("GGML_METAL_ABLATE");
+        if (!env) {
+            return r;
+        }
+        std::string s(env);
+        size_t p = 0;
+        while (p <= s.size()) {
+            size_t q = s.find(',', p);
+            if (q == std::string::npos) q = s.size();
+            std::string item = s.substr(p, q - p);
+            if (!item.empty()) {
+                size_t c = item.find(':');
+                r.emplace_back(item.substr(0, c), c == std::string::npos ? "" : item.substr(c + 1));
+                GGML_LOG_WARN("%s: ablating %s\n", __func__, item.c_str());
+            }
+            p = q + 1;
+        }
+        return r;
+    }();
+    if (rules.empty()) {
+        return false;
+    }
+    const std::string op = ggml_op_desc(node);
+    for (const auto & [rop, rtype] : rules) {
+        if (rop == op && (rtype.empty() || (node->src[0] && rtype == ggml_type_name(node->src[0]->type)))) {
+            return true;
+        }
+    }
+    return false;
+}
+
 static int ggml_metal_op_encode_impl(ggml_metal_op_t ctx, int idx) {
     struct ggml_tensor * node = ctx->node(idx);
 
@@ -189,6 +231,10 @@ static int ggml_metal_op_encode_impl(ggml_metal_op_t ctx, int idx) {
         return 1;
     }
 
+    if (ggml_metal_op_ablated(node)) {
+        return 1;
+    }
+
     switch (node->op) {
         case GGML_OP_NONE:
         case GGML_OP_RESHAPE:
@@ -2441,7 +2487,14 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
 
     // first try to use small-batch mat-mv kernels
     // these should be efficient for BS [2, ~8]
-    if (op->src[1]->type == GGML_TYPE_F32 && (ne00%128 == 0) &&
