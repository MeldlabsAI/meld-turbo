From 8b8c7e41dcedd6db754b23831e38234679eeb931 Mon Sep 17 00:00:00 2001
From: Tim <338195936+tim-meld@users.noreply.github.com>
Date: Sun, 4 Oct 2026 21:53:01 +0800
Subject: [PATCH 03/12] metal: split-K matvec for short, wide float matrices at
 decode (kernel_mul_mv_wk)

f32/f16/bf16, 1..8 tokens, ne00 >= 2048, ne01 <= 384, 2D: a threadgroup takes 4 rows and its
16 simdgroups split K; partials are reduced in threadgroup memory in a fixed order (deterministic).
The row-parallel kernels gave e.g. qwen4exp's hyper-connection inject (4 x 10240) one threadgroup.
GGML_METAL_WK_DISABLE=1 turns it off.

qwen4exp model shapes, M2 Max: bf16 decode matmuls at 4 tokens 11.6 -> 6.9 ms
(hc_inject 35 -> 9.4 us, 10240x320 42 -> 25 us). 24-layer proxy, interleaved A/B:
pp4 114-116 -> 119-127 tok/s (+4..9%), pp8 +2..3%, pp1 unchanged.
test-backend-ops: model bf16 shapes 18/18, MUL_MAT f32/f16/bf16 585/585.
---
 ggml/src/ggml-metal/ggml-metal-device.cpp | 21 ++++++
 ggml/src/ggml-metal/ggml-metal-device.h   |  1 +
 ggml/src/ggml-metal/ggml-metal-ops.cpp    | 46 ++++++++++++
 ggml/src/ggml-metal/kernels/mul_mv.metal  | 92 +++++++++++++++++++++++
 4 files changed, 160 insertions(+)

diff --git a/ggml/src/ggml-metal/ggml-metal-device.cpp b/ggml/src/ggml-metal/ggml-metal-device.cpp
index 2d38875..df0e19a 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-device.cpp
@@ -758,6 +758,27 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_solve_tri(ggml_m
     return res;
 }
 
+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv_wk(ggml_metal_library_t lib, const ggml_tensor * op, int nsg) {
+    char base[256];
+    char name[256];
+
+    snprintf(base, 256, "kernel_mul_mv_wk_%s_f32_nt%d", ggml_type_name(op->src[0]->type), (int) op->src[1]->ne[1]);
+    snprintf(name, 256, "%s_nsg=%d", base, nsg);
+
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        ggml_metal_cv_t cv = ggml_metal_cv_init();
+        ggml_metal_cv_set_int16(cv, nsg, FC_MUL_MV + 0);
+        res = ggml_metal_library_compile_pipeline(lib, base, name, cv);
+        ggml_metal_cv_free(cv);
+    }
+
+    res.nsg  = nsg;
+    res.smem = GGML_PAD(nsg*4*op->src[1]->ne[1]*sizeof(float), 16);
+
+    return res;
+}
+
 ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv_ext(ggml_metal_library_t lib, const ggml_tensor * op, int nsg, int nxpsg, int r1ptg) {
     char base[256];
     char name[256];
diff --git a/ggml/src/ggml-metal/ggml-metal-device.h b/ggml/src/ggml-metal/ggml-metal-device.h
index 1bdaecc..289e740 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.h
+++ b/ggml/src/ggml-metal/ggml-metal-device.h
@@ -135,6 +135,7 @@ struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_rwkv
 struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_gated_delta_net   (ggml_metal_library_t lib, const struct ggml_tensor * op);
 struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_solve_tri         (ggml_metal_library_t lib, const struct ggml_tensor * op);
 struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv_ext        (ggml_metal_library_t lib, const struct ggml_tensor * op, int nsg, int nxpsg, int r1ptg);
+struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv_wk         (ggml_metal_library_t lib, const struct ggml_tensor * op, int nsg);
 struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mm            (ggml_metal_library_t lib, const struct ggml_tensor * op);
 struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv            (ggml_metal_library_t lib, const struct ggml_tensor * op);
 struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mm_id_map0    (ggml_metal_library_t lib, int ne02, int ne20);
diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 14b4036..bcf95df 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -2485,6 +2485,52 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
     const int16_t r2 = ne12/ne02;
     const int16_t r3 = ne13/ne03;
 
+    // meld-turbo: short, wide float matrices at decode (few rows, long K, 1..8 tokens): split K inside
+    // a threadgroup (kernel_mul_mv_wk) so they are not left with a handful of threadgroups.
+    static const bool wk_disabled = getenv("GGML_METAL_WK_DISABLE") != nullptr;
+    if (!wk_disabled &&
+        (op->src[0]->type == GGML_TYPE_F32 || op->src[0]->type == GGML_TYPE_F16 || op->src[0]->type == GGML_TYPE_BF16) &&
+        op->src[1]->type == GGML_TYPE_F32 && op->type == GGML_TYPE_F32 &&
+        ne11 >= 1 && ne11 <= 8 && ne00 % 4 == 0 && ne00 >= 2048 && ne01 <= 384 &&
+        ne02 == 1 && ne03 == 1 && ne12 == 1 && ne13 == 1 &&
+        nb00 == ggml_type_size(op->src[0]->type) && nb01 % 16 == 0 && nb10 == sizeof(float) && nb11 % 16 == 0 &&
+        ggml_is_contiguous(op)) {
+        const int nsg = 16;
+        auto pipeline = ggml_metal_library_get_pipeline_mul_mv_wk(lib, op, nsg);
+
+        ggml_metal_kargs_mul_mv_ext args = {
+            /*.ne00  =*/ ne00,
+            /*.ne01  =*/ ne01,
+            /*.ne02  =*/ ne02,
+            /*.nb00  =*/ nb00,
+            /*.nb01  =*/ nb01,
+            /*.nb02  =*/ nb02,
+            /*.nb03  =*/ nb03,
+            /*.ne10  =*/ ne10,
+            /*.ne11  =*/ ne11,
+            /*.ne12  =*/ ne12,
+            /*.nb10  =*/ nb10,
+            /*.nb11  =*/ nb11,
+            /*.nb12  =*/ nb12,
+            /*.nb13  =*/ nb13,
+            /*.ne0   =*/ ne0,
+            /*.ne1   =*/ ne1,
+            /*.r2    =*/ r2,
+            /*.r3    =*/ r3,
+        };
+
+        ggml_metal_encoder_set_pipeline(enc, pipeline);
+        ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+        ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[0]), 1);
+        ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[1]), 2);
+        ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op),         3);
+        ggml_metal_encoder_set_threadgroup_memory_size(enc, pipeline.smem, 0);
+
+        ggml_metal_encoder_dispatch_threadgroups(enc, (ne01 + 3)/4, 1, 1, 32, nsg, 1);
+
+        return 1;
+    }
+
     // first try to use small-batch mat-mv kernels
     // these should be efficient for BS [2, ~8]
     //
diff --git a/ggml/src/ggml-metal/kernels/mul_mv.metal b/ggml/src/ggml-metal/kernels/mul_mv.metal
index 7d22e14..b16545a 100644
--- a/ggml/src/ggml-metal/kernels/mul_mv.metal
+++ b/ggml/src/ggml-metal/kernels/mul_mv.metal
@@ -3374,3 +3374,95 @@ template [[host_name("kernel_mul_mv_id_iq2_s_f32")]]   kernel kernel_mul_mv_id_t
 template [[host_name("kernel_mul_mv_id_iq4_nl_f32")]]  kernel kernel_mul_mv_id_t kernel_mul_mv_id<mmv_fn<kernel_mul_mv_iq4_nl_f32_impl <N_R0_IQ4_NL>>>;
 template [[host_name("kernel_mul_mv_id_iq4_xs_f32")]]  kernel kernel_mul_mv_id_t kernel_mul_mv_id<mmv_fn<kernel_mul_mv_iq4_xs_f32_impl <N_R0_IQ4_XS>>>;
 template [[host_name("kernel_mul_mv_id_tq2_0_f32")]]   kernel kernel_mul_mv_id_t kernel_mul_mv_id<mmv_fn<kernel_mul_mv_tq2_0_f32_impl  <N_R0_TQ2_0>>>;
+
+
+// meld-turbo: decode matvec for short, wide float matrices (few rows, long K) over NT = 1..8 tokens.
+// The per-row kernels give such a matrix only a handful of threadgroups (qwen4exp's hyper-connection
+// inject is 4 x 10240: one threadgroup), so most of the GPU idles. Here a threadgroup takes WK_ROWS
+// rows and its NSG simdgroups split K; partial sums are reduced in threadgroup memory in a fixed order,
+// so the result is deterministic.
+#define WK_ROWS 4
+
+template<typename T4, short NT>
+kernel void kernel_mul_mv_wk(
+        constant ggml_metal_kargs_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    const short NSG = FC_mul_mv_nsg;
+
+    const int row0 = tgpig.x*WK_ROWS;
+    const int K4   = args.ne00/4;
+
+    float acc[WK_ROWS][NT];
+    for (short r = 0; r < WK_ROWS; ++r) {
+        for (short t = 0; t < NT; ++t) {
+            acc[r][t] = 0.0f;
+        }
+    }
+
+    device const T4 * x[WK_ROWS];
+    for (short r = 0; r < WK_ROWS; ++r) {
+        const int row = min(row0 + r, args.ne01 - 1);   // clamp: rows past the end are computed but not stored
+        x[r] = (device const T4 *) (src0 + (uint64_t) row*args.nb01);
+    }
+
+    for (int i = sgitg*32 + tiisg; i < K4; i += NSG*32) {
+        float4 y[NT];
+        for (short t = 0; t < NT; ++t) {
+            y[t] = ((device const float4 *) (src1 + (uint64_t) t*args.nb11))[i];
+        }
+        for (short r = 0; r < WK_ROWS; ++r) {
+            const float4 xv = float4(x[r][i]);
+            for (short t = 0; t < NT; ++t) {
+                acc[r][t] += dot(xv, y[t]);
+            }
+        }
+    }
+
+    threadgroup float * part = (threadgroup float *) shmem;   // [NSG][WK_ROWS][NT]
+    for (short r = 0; r < WK_ROWS; ++r) {
+        for (short t = 0; t < NT; ++t) {
+            const float v = simd_sum(acc[r][t]);
+            if (tiisg == 0) {
+                part[(sgitg*WK_ROWS + r)*NT + t] = v;
+            }
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const short idx = sgitg*32 + tiisg;
+    if (idx < WK_ROWS*NT) {
+        const short r = idx / NT;
+        const short t = idx % NT;
+        if (row0 + r < args.ne01) {
+            float sum = 0.0f;
+            for (short sg = 0; sg < NSG; ++sg) {
+                sum += part[(sg*WK_ROWS + r)*NT + t];
+            }
+            ((device float *) dst)[(uint64_t) t*args.ne0 + row0 + r] = sum;
+        }
+    }
+}
+
+typedef decltype(kernel_mul_mv_wk<float4, 1>) mul_mv_wk_t;
+
+#define WK_INST(NAME, T4) \
+template [[host_name("kernel_mul_mv_wk_" NAME "_f32_nt1")]] kernel mul_mv_wk_t kernel_mul_mv_wk<T4, 1>; \
+template [[host_name("kernel_mul_mv_wk_" NAME "_f32_nt2")]] kernel mul_mv_wk_t kernel_mul_mv_wk<T4, 2>; \
+template [[host_name("kernel_mul_mv_wk_" NAME "_f32_nt3")]] kernel mul_mv_wk_t kernel_mul_mv_wk<T4, 3>; \
+template [[host_name("kernel_mul_mv_wk_" NAME "_f32_nt4")]] kernel mul_mv_wk_t kernel_mul_mv_wk<T4, 4>; \
+template [[host_name("kernel_mul_mv_wk_" NAME "_f32_nt5")]] kernel mul_mv_wk_t kernel_mul_mv_wk<T4, 5>; \
+template [[host_name("kernel_mul_mv_wk_" NAME "_f32_nt6")]] kernel mul_mv_wk_t kernel_mul_mv_wk<T4, 6>; \
+template [[host_name("kernel_mul_mv_wk_" NAME "_f32_nt7")]] kernel mul_mv_wk_t kernel_mul_mv_wk<T4, 7>; \
+template [[host_name("kernel_mul_mv_wk_" NAME "_f32_nt8")]] kernel mul_mv_wk_t kernel_mul_mv_wk<T4, 8>;
+
+WK_INST("f32", float4)
+WK_INST("f16", half4)
+#if defined(GGML_METAL_HAS_BF16)
+WK_INST("bf16", bfloat4)
+#endif
