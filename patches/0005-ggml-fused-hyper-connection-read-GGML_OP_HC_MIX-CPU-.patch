+int ggml_metal_op_hc_mix(ggml_metal_op_t ctx, int idx) {
+    ggml_tensor * op = ctx->node(idx);
+    ggml_metal_encoder_t enc = ctx->enc;
+
+    const ggml_tensor * x = op->src[0];
+    ggml_metal_kargs_hc_mix args = {
+        /*.n_embd    =*/ ggml_get_op_params_i32(op, 3),
+        /*.hc        =*/ ggml_get_op_params_i32(op, 4),
+        /*.nt        =*/ ggml_get_op_params_i32(op, 5),
+        /*.lr        =*/ ggml_get_op_params_i32(op, 6),
+        /*.n_inj     =*/ ggml_get_op_params_i32(op, 7),
+        /*.nb_x1     =*/ x->nb[1],
+        /*.nb_x2     =*/ x->nb[2],
+        /*.eps       =*/ ggml_get_op_params_f32(op, 0),
+        /*.lo_scale  =*/ ggml_get_op_params_f32(op, 1),
+        /*.mix_scale =*/ ggml_get_op_params_f32(op, 2),
+    };
+
+    auto bx   = ggml_metal_get_buffer_id(x);
+    auto bwn  = ggml_metal_get_buffer_id(op->src[1]);
+    auto bwd  = ggml_metal_get_buffer_id(op->src[2]);
+    auto bwu  = ggml_metal_get_buffer_id(op->src[3]);
+    auto bwi  = op->src[4] ? ggml_metal_get_buffer_id(op->src[4]) : bwd;
+    auto bdst = ggml_metal_get_buffer_id(op);
+
+    // 1. inverse rms per (stream, token)
+    {
+        auto pipeline = ggml_metal_library_get_pipeline_hc_mix(ctx->lib, op, 0);
+        ggml_metal_encoder_set_pipeline(enc, pipeline);
+        ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+        ggml_metal_encoder_set_buffer  (enc, bx,   1);
+        ggml_metal_encoder_set_buffer  (enc, bdst, 2);
+        ggml_metal_encoder_set_threadgroup_memory_size(enc, 32*sizeof(float), 0);
+        ggml_metal_encoder_dispatch_threadgroups(enc, args.hc, args.nt, 1, 256, 1, 1);
+    }
+    ggml_metal_encoder_memory_barrier(enc);
+    // 2. down projection + inject (split K over simdgroups, HC_MIX_DOWN_ROWS rows per threadgroup)
+    {
+        auto pipeline = ggml_metal_library_get_pipeline_hc_mix(ctx->lib, op, 1);
+        ggml_metal_encoder_set_pipeline(enc, pipeline);
+        ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+        ggml_metal_encoder_set_buffer  (enc, bx,   1);
+        ggml_metal_encoder_set_buffer  (enc, bwn,  2);
+        ggml_metal_encoder_set_buffer  (enc, bwd,  3);
+        ggml_metal_encoder_set_buffer  (enc, bwi,  4);
+        ggml_metal_encoder_set_buffer  (enc, bdst, 5);
+        // split K over up to 16 simdgroups; heavy variants (bf16, nt=8) allow fewer threads per group
+        const int nsg = std::min(16, ggml_metal_pipeline_max_theads_per_threadgroup(pipeline)/32);
+        ggml_metal_encoder_set_threadgroup_memory_size(enc, GGML_PAD(nsg*HC_MIX_DOWN_ROWS*args.nt*sizeof(float), 16), 0);
+        const int nrows = args.lr + args.n_inj;
+        ggml_metal_encoder_dispatch_threadgroups(enc, (nrows + HC_MIX_DOWN_ROWS - 1)/HC_MIX_DOWN_ROWS, 1, 1, 32, nsg, 1);
+    }
