+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_hc_mix(ggml_metal_library_t lib, const ggml_tensor * op, int stage) {
+    // stage 0: rms, 1: down, 2: up
+    char name[256];
+    if (stage == 0) {
+        snprintf(name, 256, "kernel_hc_mix_rms");
+    } else {
+        snprintf(name, 256, "kernel_hc_mix_%s_%s_nt%d", stage == 1 ? "down" : "up",
+                 ggml_type_name(op->src[2]->type), ggml_get_op_params_i32(op, 5));
+    }
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        res = ggml_metal_library_compile_pipeline(lib, name, name, nullptr);
+    }
+    return res;
+}
