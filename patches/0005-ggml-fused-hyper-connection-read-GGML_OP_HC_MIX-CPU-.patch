+// ggml_compute_forward_hc_mix (meld-turbo): single-threaded reference, see ggml_hc_mix() in ggml.h
+
+static inline float hc_mix_w(const ggml_tensor * w, int64_t i) {
+    switch (w->type) {
+        case GGML_TYPE_F32:  return ((const float *) w->data)[i];
+        case GGML_TYPE_F16:  return GGML_CPU_FP16_TO_FP32(((const ggml_fp16_t *) w->data)[i]);
+        case GGML_TYPE_BF16: return GGML_BF16_TO_FP32(((const ggml_bf16_t *) w->data)[i]);
+        default: GGML_ABORT("hc_mix: unsupported weight type %s", ggml_type_name(w->type));
+    }
+}
+
+void ggml_compute_forward_hc_mix(const ggml_compute_params * params, ggml_tensor * dst) {
+    if (params->ith != 0) {
+        return;
+    }
+    const ggml_tensor * x      = dst->src[0];
+    const ggml_tensor * w_norm = dst->src[1];
+    const ggml_tensor * w_down = dst->src[2];
+    const ggml_tensor * w_up   = dst->src[3];
+    const ggml_tensor * w_inj  = dst->src[4];
+
+    const float   eps       = ggml_get_op_params_f32(dst, 0);
+    const float   lo_scale  = ggml_get_op_params_f32(dst, 1);
+    const float   mix_scale = ggml_get_op_params_f32(dst, 2);
+    const int64_t n_embd    = ggml_get_op_params_i32(dst, 3);
+    const int64_t hc        = ggml_get_op_params_i32(dst, 4);
+    const int64_t nt        = ggml_get_op_params_i32(dst, 5);
+    const int64_t lr        = ggml_get_op_params_i32(dst, 6);
+    const int64_t n_inj     = ggml_get_op_params_i32(dst, 7);
+    const int64_t hc_dim    = n_embd*hc;
+
+    float * out    = (float *) dst->data;
+    float * mixed  = out;
+    float * inj    = mixed + n_embd*nt;
+    float * lo     = inj + n_inj*nt;
+    float * rinv   = lo + lr*nt;
+    const float * wn = (const float *) w_norm->data;
+
+    std::vector<float> xn(hc_dim);
+    for (int64_t t = 0; t < nt; ++t) {
+        const float * xt = (const float *) ((const char *) x->data + t*x->nb[2]);
+        for (int64_t c = 0; c < hc; ++c) {
+            const float * xc = (const float *) ((const char *) xt + c*x->nb[1]);
+            double ss = 0.0;
+            for (int64_t i = 0; i < n_embd; ++i) ss += (double) xc[i]*xc[i];
+            rinv[t*hc + c] = 1.0f/sqrtf((float) (ss/n_embd) + eps);
+            for (int64_t i = 0; i < n_embd; ++i) xn[c*n_embd + i] = xc[i]*rinv[t*hc + c]*wn[c*n_embd + i];
+        }
+        for (int64_t j = 0; j < lr; ++j) {
+            double acc = 0.0;
+            for (int64_t k = 0; k < hc_dim; ++k) acc += (double) hc_mix_w(w_down, j*hc_dim + k)*xn[k];
+            const float v = lo_scale*(float) acc;
+            lo[t*lr + j] = v/(1.0f + expf(-v));
+        }
+        for (int64_t h = 0; h < n_inj; ++h) {
+            double acc = 0.0;
+            for (int64_t k = 0; k < hc_dim; ++k) acc += (double) hc_mix_w(w_inj, h*hc_dim + k)*xn[k];
+            inj[t*n_inj + h] = (float) acc;
+        }
+        for (int64_t i = 0; i < n_embd; ++i) {
+            double m = 0.0;
+            for (int64_t c = 0; c < hc; ++c) {
+                const int64_t r = c*n_embd + i;
+                double g = 0.0;
+                for (int64_t j = 0; j < lr; ++j) g += (double) hc_mix_w(w_up, r*lr + j)*lo[t*lr + j];
+                m += (double) xn[r]/(1.0 + exp(-g));
+            }
+            mixed[t*n_embd + i] = mix_scale*(float) m;
+        }
+    }
+}
