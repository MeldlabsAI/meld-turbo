+// ggml_hc_mix (meld-turbo)
+
+struct ggml_tensor * ggml_hc_mix(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * w_norm,
+        struct ggml_tensor  * w_down,
+        struct ggml_tensor  * w_up,
+        struct ggml_tensor  * w_inject,
+        float                 eps,
+        float                 lo_scale,
+        float                 mix_scale) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && w_norm->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(w_norm));
+    const int64_t n_embd = x->ne[0];
+    const int64_t hc     = x->ne[1];
+    const int64_t nt     = x->ne[2];
+    const int64_t hc_dim = n_embd*hc;
+    const int64_t lr     = w_down->ne[1];
+    const int64_t n_inj  = w_inject ? w_inject->ne[1] : 0;
+    GGML_ASSERT(x->ne[3] == 1);
+    GGML_ASSERT(ggml_nelements(w_norm) == hc_dim);
+    GGML_ASSERT(w_down->ne[0] == hc_dim && ggml_is_contiguous(w_down));
+    GGML_ASSERT(w_up->ne[0] == lr && w_up->ne[1] == hc_dim && ggml_is_contiguous(w_up));
+    GGML_ASSERT(!w_inject || (w_inject->ne[0] == hc_dim && ggml_is_contiguous(w_inject)));
+
+    const int64_t n_total = (n_embd + n_inj + lr + hc)*nt;
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_total);
+
+    ggml_set_op_params_f32(result, 0, eps);
+    ggml_set_op_params_f32(result, 1, lo_scale);
+    ggml_set_op_params_f32(result, 2, mix_scale);
+    ggml_set_op_params_i32(result, 3, (int32_t) n_embd);
+    ggml_set_op_params_i32(result, 4, (int32_t) hc);
+    ggml_set_op_params_i32(result, 5, (int32_t) nt);
+    ggml_set_op_params_i32(result, 6, (int32_t) lr);
+    ggml_set_op_params_i32(result, 7, (int32_t) n_inj);
+
+    result->op     = GGML_OP_HC_MIX;
+    result->src[0] = x;
+    result->src[1] = w_norm;
+    result->src[2] = w_down;
+    result->src[3] = w_up;
+    result->src[4] = w_inject;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_hc_mix_mixed(struct ggml_context * ctx, struct ggml_tensor * r) {
+    GGML_ASSERT(r->op == GGML_OP_HC_MIX);
+    const int64_t n_embd = ggml_get_op_params_i32(r, 3);
+    const int64_t nt     = ggml_get_op_params_i32(r, 5);
+    return ggml_view_2d(ctx, r, n_embd, nt, n_embd*sizeof(float), 0);
+}
+
+struct ggml_tensor * ggml_hc_mix_inject(struct ggml_context * ctx, struct ggml_tensor * r) {
+    GGML_ASSERT(r->op == GGML_OP_HC_MIX);
+    const int64_t n_embd = ggml_get_op_params_i32(r, 3);
+    const int64_t nt     = ggml_get_op_params_i32(r, 5);
+    const int64_t n_inj  = ggml_get_op_params_i32(r, 7);
+    GGML_ASSERT(n_inj > 0);
+    return ggml_view_2d(ctx, r, n_inj, nt, n_inj*sizeof(float), n_embd*nt*sizeof(float));
+}
