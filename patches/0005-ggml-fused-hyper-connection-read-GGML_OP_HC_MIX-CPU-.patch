diff --git a/ggml/src/ggml-metal/kernels/hc_mix.metal b/ggml/src/ggml-metal/kernels/hc_mix.metal
new file mode 100644
index 0000000..3fc3523
--- /dev/null
+++ b/ggml/src/ggml-metal/kernels/hc_mix.metal
@@ -0,0 +1,177 @@
+#include "common.h"
+
+// meld-turbo: fused hyper-connection read for Qwen3.8-Flash-Next (ggml_hc_mix), in three dispatches:
+//   1. kernel_hc_mix_rms : inverse rms of every (stream, token)
+//   2. kernel_hc_mix_down: lo = silu(lo_scale * w_down . xn) and inj = w_inject . xn, all tokens per weight read
+//   3. kernel_hc_mix_up  : mixed[i] = mix_scale * sum_c xn[c, i] * sigmoid(w_up[c, i] . lo)
+// xn = x * inv_rms(stream) * w_norm is recomputed where needed instead of being stored.
+// Output buffer: mixed [n_embd, nt] | inj [n_inj, nt] | lo [lr, nt] | rinv [hc, nt]
+
+#define HC_ROWS   HC_MIX_DOWN_ROWS // rows per threadgroup in the down projection (ggml-metal-impl.h)
+#define HC_NSG_UP 8                // positions (one simdgroup each) per threadgroup in the up projection
+
+kernel void kernel_hc_mix_rms(
+        constant ggml_metal_kargs_hc_mix & args,
+        device const char * x,
+        device       char * dst,
+        threadgroup  float * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg3[[thread_position_in_threadgroup]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]],
+        ushort3 ntg3[[threads_per_threadgroup]]) {
+    const int c = tgpig.x;
+    const int t = tgpig.y;
+    const int tpitg = tpitg3.x;
+    const int ntg   = ntg3.x;
+    device const float * xc = (device const float *) (x + t*args.nb_x2 + c*args.nb_x1);
+    float s = 0.0f;
+    for (int i = tpitg; i < args.n_embd; i += ntg) {
+        s += xc[i]*xc[i];
+    }
+    s = simd_sum(s);
+    if (tiisg == 0) shmem[sgitg] = s;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tpitg == 0) {
+        float tot = 0.0f;
+        for (int k = 0; k < (ntg + 31)/32; ++k) tot += shmem[k];
+        device float * rinv = (device float *) dst + (args.n_embd + args.n_inj + args.lr)*args.nt;
+        rinv[t*args.hc + c] = 1.0f/sqrt(tot/args.n_embd + args.eps);
+    }
+}
+
+template<typename T4, short NT>
+kernel void kernel_hc_mix_down(
+        constant ggml_metal_kargs_hc_mix & args,
+        device const char * x,
+        device const char * w_norm,
+        device const char * w_down,
+        device const char * w_inj,
+        device       char * dst,
+        threadgroup  float * shmem [[threadgroup(0)]],
+        uint   tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]],
+        ushort nsg  [[simdgroups_per_threadgroup]]) {
+    const int hc_dim = args.n_embd*args.hc;
+    const int K4     = hc_dim/4;
+    const int nrows  = args.lr + args.n_inj;
+    const int row0   = tgpig*HC_ROWS;
+
+    device float * out  = (device float *) dst;
+    device float * inj  = out + args.n_embd*args.nt;
+    device float * lo   = inj + args.n_inj*args.nt;
+    device const float * rinv = lo + args.lr*args.nt;
+    device const float4 * wn4 = (device const float4 *) w_norm;
+
+    device const T4 * w[HC_ROWS];
+    for (short r = 0; r < HC_ROWS; ++r) {
+        const int row = min(row0 + r, nrows - 1);
+        w[r] = row < args.lr ? (device const T4 *) w_down + (uint64_t) row*K4
+                             : (device const T4 *) w_inj  + (uint64_t) (row - args.lr)*K4;
+    }
+
+    float acc[HC_ROWS][NT];
+    for (short r = 0; r < HC_ROWS; ++r) for (short t = 0; t < NT; ++t) acc[r][t] = 0.0f;
+
+    const int n_embd4 = args.n_embd/4;
+    for (int i = sgitg*32 + tiisg; i < K4; i += nsg*32) {
+        const int c = i / n_embd4;
+        const float4 g = wn4[i];
+        float4 y[NT];
+        for (short t = 0; t < NT; ++t) {
+            device const float4 * xt = (device const float4 *) (x + t*args.nb_x2 + c*args.nb_x1);
+            y[t] = xt[i - c*n_embd4]*(rinv[t*args.hc + c])*g;
+        }
+        for (short r = 0; r < HC_ROWS; ++r) {
+            const float4 wv = float4(w[r][i]);
+            for (short t = 0; t < NT; ++t) acc[r][t] += dot(wv, y[t]);
+        }
+    }
+
+    for (short r = 0; r < HC_ROWS; ++r) {
+        for (short t = 0; t < NT; ++t) {
+            const float v = simd_sum(acc[r][t]);
+            if (tiisg == 0) shmem[(sgitg*HC_ROWS + r)*NT + t] = v;
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const short idx = sgitg*32 + tiisg;
+    if (idx < HC_ROWS*NT) {
+        const short r = idx / NT;
+        const short t = idx % NT;
+        const int row = row0 + r;
+        if (row < nrows) {
+            float sum = 0.0f;
+            for (short sg = 0; sg < nsg; ++sg) sum += shmem[(sg*HC_ROWS + r)*NT + t];
+            if (row < args.lr) {
+                const float v = args.lo_scale*sum;
+                lo[t*args.lr + row] = v/(1.0f + exp(-v));
+            } else {
+                inj[t*args.n_inj + (row - args.lr)] = sum;
+            }
+        }
+    }
+}
+
+template<typename T4, short NT>
+kernel void kernel_hc_mix_up(
+        constant ggml_metal_kargs_hc_mix & args,
+        device const char * x,
+        device const char * w_norm,
+        device const char * w_up,
+        device       char * dst,
+        uint   tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    // one simdgroup per position i; the 32 lanes split into hc groups, one stream (w_up row) each
+    const int i = tgpig*HC_NSG_UP + sgitg;
+    if (i >= args.n_embd) return;
+
+    const short lpr = 32/args.hc;          // lanes per row (hc is a power of two <= 32)
+    const short c   = tiisg/lpr;
+    const short l   = tiisg%lpr;
+
+    device float * out = (device float *) dst;
+    device const float * lo   = out + (args.n_embd + args.n_inj)*args.nt;
+    device const float * rinv = lo + args.lr*args.nt;
+    device const float * wn   = (device const float *) w_norm;
+    const int lr4 = args.lr/4;
+    const int r   = c*args.n_embd + i;
+    device const T4 * wr = (device const T4 *) w_up + (uint64_t) r*lr4;
+
+    float g[NT];
+    for (short t = 0; t < NT; ++t) g[t] = 0.0f;
+    for (int j = l; j < lr4; j += lpr) {
+        const float4 wv = float4(wr[j]);
+        for (short t = 0; t < NT; ++t) g[t] += dot(wv, ((device const float4 *) (lo + t*args.lr))[j]);
+    }
+    for (short t = 0; t < NT; ++t) {
+        for (short o = lpr/2; o > 0; o /= 2) g[t] += simd_shuffle_xor(g[t], o);
+        device const float * xc = (device const float *) (x + t*args.nb_x2 + c*args.nb_x1);
+        float m = xc[i]*rinv[t*args.hc + c]*wn[r]/(1.0f + exp(-g[t]));
+        for (short o = lpr; o < 32; o *= 2) m += simd_shuffle_xor(m, o);
+        g[t] = m;
+    }
+    if (tiisg == 0) {
+        for (short t = 0; t < NT; ++t) out[t*args.n_embd + i] = args.mix_scale*g[t];
+    }
+}
+
+typedef decltype(kernel_hc_mix_down<float4, 1>) hc_mix_down_t;
+typedef decltype(kernel_hc_mix_up<float4, 1>)   hc_mix_up_t;
+
+#define HC_MIX_INST(NAME, T4, N) \
+template [[host_name("kernel_hc_mix_down_" NAME "_nt" #N)]] kernel hc_mix_down_t kernel_hc_mix_down<T4, N>; \
+template [[host_name("kernel_hc_mix_up_"   NAME "_nt" #N)]] kernel hc_mix_up_t   kernel_hc_mix_up<T4, N>;
+
+#define HC_MIX_INST_ALL(NAME, T4) \
+HC_MIX_INST(NAME, T4, 1) HC_MIX_INST(NAME, T4, 2) HC_MIX_INST(NAME, T4, 3) HC_MIX_INST(NAME, T4, 4) \
+HC_MIX_INST(NAME, T4, 5) HC_MIX_INST(NAME, T4, 6) HC_MIX_INST(NAME, T4, 7) HC_MIX_INST(NAME, T4, 8)
+
+HC_MIX_INST_ALL("f32", float4)
+HC_MIX_INST_ALL("f16", half4)
+#if defined(GGML_METAL_HAS_BF16)
+HC_MIX_INST_ALL("bf16", bfloat4)
+#endif
